import os
import datetime
import subprocess

def make_commit():
    # Set the repository path (replace with your repository path if needed)
    repo_path = "/path/to/your/repository"
    
    # Set the commit message
    commit_message = f"Data-driven network analysis insights - {datetime.datetime.now().strftime('%Y-%m-%d')}"
    
    # Change to the repository directory
    os.chdir(repo_path)
    
    # Stage all changes
    subprocess.run(["git", "add", "."])
    
    # Commit with the generated message
    subprocess.run(["git", "commit", "-m", commit_message])
    
    # Push to the repository (ensure you have the correct remote set up)
    subprocess.run(["git", "push"])

if __name__ == "__main__":
    make_commit()
